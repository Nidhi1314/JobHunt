# ── LLM ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Web Search / Crawl Fallback ───────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Email (Twilio SendGrid) ───────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sender@email.com
ALERT_TO_EMAIL=your_email@gmail.com

# ── Scheduler ─────────────────────────────────────────
PIPELINE_SCHEDULE_HOUR=8
PIPELINE_SCHEDULE_MINUTE=0

# ── Observability (optional) ──────────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=jobhunt-ai

# ── App ───────────────────────────────────────────────
APP_ENV=development
DATABASE_URL=sqlite:///./jobhunt.db
